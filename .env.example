APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RAILWAY_DATABASE_URL=sqlite:///./backend/app/data/crew_management.db
RAILWAY_JWT_SECRET=replace-with-a-long-random-secret
# Set these once for first deployment, then remove the password from the environment.
RAILWAY_BOOTSTRAP_ADMIN_ID=EMP-ADMIN
RAILWAY_BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.in
RAILWAY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-16-plus-characters

# Email workflow. Local development queues previews in EMAIL_OUTBOX_PATH.
EMAIL_MODE=outbox
EMAIL_OUTBOX_PATH=./backend/app/data/email_outbox.jsonl
# Set EMAIL_MODE=smtp in a deployed environment and provide these values.
EMAIL_FROM=no-reply@example.gov.in
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
